# FinSift API base URL
VITE_API_URL=http://localhost:3000
# Clerk → API keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=
# Development only: "true" answers every request from local fixtures and skips Clerk (design review).
# Preview mode also turns on automatically in dev when no Clerk key is set.
VITE_PREVIEW_MODE=false
